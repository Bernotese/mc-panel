{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-dist.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "dev:mock": "vite --mode mock",
    "e2e": "playwright test --project=mock",
    "e2e:real": "playwright test --project=real",
    "shots": "playwright test --project=screenshots"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-virtual": "^3.14.21",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "get-nonce": "^1.0.1",
    "i18next": "^26.5.3",
    "lucide-react": "^1.60.0",
    "openapi-fetch": "^0.17.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.47",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
