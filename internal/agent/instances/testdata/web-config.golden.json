{
  "admin": {
    "disabled": true,
    "config": {
      "persist": false
    }
  },
  "apps": {
    "http": {
      "servers": {
        "ask": {
          "listen": [
            ":8081"
          ],
          "automatic_https": {
            "disable": true
          },
          "routes": [
            {
              "match": [
                {
                  "query": {
                    "domain": [
                      "survival.example.com"
                    ]
                  }
                }
              ],
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 200
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "query": {
                    "domain": [
                      "xn--mnchen-3ya.0-9.example.com"
                    ]
                  }
                }
              ],
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 200
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "query": {
                    "domain": [
                      "paths.example.com"
                    ]
                  }
                }
              ],
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 200
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 404
                }
              ]
            }
          ]
        },
        "proxy": {
          "listen": [
            ":8080"
          ],
          "automatic_https": {
            "disable": true
          },
          "trusted_proxies": {
            "source": "static",
            "ranges": [
              "10.213.255.240/28"
            ]
          },
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "survival.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "match": [
                        {
                          "path": [
                            "/afk-smoke"
                          ]
                        }
                      ],
                      "handle": [
                        {
                          "handler": "static_response",
                          "status_code": 308,
                          "headers": {
                            "Location": [
                              "/afk-smoke/"
                            ]
                          }
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "match": [
                        {
                          "path": [
                            "/afk-smoke/*"
                          ]
                        }
                      ],
                      "handle": [
                        {
                          "handler": "rewrite",
                          "strip_path_prefix": "/afk-smoke"
                        },
                        {
                          "handler": "headers",
                          "request": {
                            "set": {
                              "X-Forwarded-Prefix": [
                                "/afk-smoke"
                              ]
                            }
                          }
                        },
                        {
                          "handler": "reverse_proxy",
                          "upstreams": [
                            {
                              "dial": "mcpanel-mc-3:8200"
                            }
                          ]
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "upstreams": [
                            {
                              "dial": "mcpanel-mc-3:8100"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "xn--mnchen-3ya.0-9.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "upstreams": [
                            {
                              "dial": "mcpanel-mc-12:65535"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "paths.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "match": [
                        {
                          "path": [
                            "/map"
                          ]
                        }
                      ],
                      "handle": [
                        {
                          "handler": "static_response",
                          "status_code": 308,
                          "headers": {
                            "Location": [
                              "/map/"
                            ]
                          }
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "match": [
                        {
                          "path": [
                            "/map/*"
                          ]
                        }
                      ],
                      "handle": [
                        {
                          "handler": "rewrite",
                          "strip_path_prefix": "/map"
                        },
                        {
                          "handler": "headers",
                          "request": {
                            "set": {
                              "X-Forwarded-Prefix": [
                                "/map"
                              ]
                            }
                          }
                        },
                        {
                          "handler": "reverse_proxy",
                          "upstreams": [
                            {
                              "dial": "mcpanel-mc-20:8300"
                            }
                          ]
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "handle": [
                        {
                          "handler": "static_response",
                          "status_code": 404,
                          "body": "Not found\n"
                        }
                      ]
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 404,
                  "body": "Not found\n"
                }
              ]
            }
          ],
          "errors": {
            "routes": [
              {
                "handle": [
                  {
                    "handler": "static_response",
                    "status_code": 502,
                    "body": "The server's web interface is not reachable right now.\n"
                  }
                ]
              }
            ]
          }
        }
      }
    }
  }
}
