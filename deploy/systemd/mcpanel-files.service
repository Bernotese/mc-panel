# Managed by mc-panel install.sh {{VERSION}}; install.sh update rewrites this file.
[Unit]
Description=mc-panel files service (unprivileged, Minecraft data)
Requires=mcpanel-files.socket
Wants=mcpanel-agent.service
After=network-online.target mcpanel-files.socket mcpanel-agent.service

[Service]
User=mcpanel-mc
Group=mcpanel-mc
ExecStart=/usr/local/bin/files -config /etc/mc-panel-files/files.toml
Restart=on-failure
RestartSec=2
# Sandbox (SEC-12; also for its child restic). The socket comes from mcpanel-files.socket, so
# the service needs no network at all.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths={{INSTANCES_DIR}}/instances {{INSTANCES_DIR}}/backups
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027
MemoryMax=1G
TasksMax=512
IOWeight=50
CPUWeight=50

[Install]
WantedBy=multi-user.target
