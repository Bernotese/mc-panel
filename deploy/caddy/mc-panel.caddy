# Managed by mc-panel install.sh {{VERSION}}; install.sh update rewrites this file.
# Imported from /etc/caddy/Caddyfile (line "import mc-panel.caddy"); other sites stay there.
{{DOMAIN}} {
	{{TLS}}
	# Access log: client IPs, URLs and user agents. Caddy redacts cookies and Authorization;
	# the CSRF token is dropped here.
	log {
		output file /var/log/caddy/mc-panel.log {
			roll_size 50MiB
			roll_keep 14
		}
		format filter {
			wrap json
			fields {
				request>headers>X-Csrf-Token delete
			}
		}
	}
	# Your additions (basic_auth, an IP allowlist, …) go into /etc/caddy/mc-panel.d/*.caddy;
	# this file is rewritten by install and update, that directory never.
	import /etc/caddy/mc-panel.d/*.caddy
	reverse_proxy unix//run/mc-panel-web/panel.sock
}
